// ID: GCI-KQL-FW-001
// Title: Rare firewall destinations for triage
// Platform: Microsoft Sentinel
// Type: Behavioural hunt (rarity is not proof of maliciousness)
// Data source: CommonSecurityLog
// Required fields: TimeGenerated, SourceIP, DestinationIP, DestinationPort, DeviceVendor, DeviceProduct
// Maturity: Draft — validate parser, direction semantics and baseline in your environment
// Source: GCI baseline library addition
// ATT&CK: No technique assigned; enrich and correlate before mapping.
// False positives: New SaaS, software updates, CDNs, DNS/proxy architecture changes and newly deployed services.
// Tuning: Establish a 14–30 day baseline; filter approved destinations and known scanners. Add direction filter only after confirming your parser's direction field.

let Lookback = 24h;
CommonSecurityLog
| where TimeGenerated >= ago(Lookback)
| where isnotempty(SourceIP) and isnotempty(DestinationIP)
| summarize Events = count(),
            UniqueSources = dcount(SourceIP),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated),
            SampleSources = make_set(SourceIP, 10)
    by DestinationIP, DestinationPort, DeviceVendor, DeviceProduct
| where Events >= 10 and UniqueSources <= 3
| order by Events desc
