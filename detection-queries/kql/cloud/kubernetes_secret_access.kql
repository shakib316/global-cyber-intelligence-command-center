// ID: GCI-KQL-CLD-001
// Title: Kubernetes Secret reads and pod creation
// Platform: Microsoft Sentinel
// Type: Audit-log hunt
// Data source: KubernetesAudit (custom table; schema is environment-specific)
// Required fields: TimeGenerated, ObjectRefResource, Verb, UserUsername, ObjectRefNamespace, ObjectRefName, SourceIPs
// Maturity: Draft — custom table and column names must be mapped to actual parser
// Source: reports/2026/11/22.md
// ATT&CK: Potential credential access / container administration lead; map after confirming audit semantics.
// False positives: Controllers, GitOps, secret synchronisation, deployment automation and approved operators.
// Tuning: Baseline service accounts and namespaces; correlate secret reads with pod creation, token use and workload identity.

KubernetesAudit
| where TimeGenerated >= ago(24h)
| where ObjectRefResource in ("secrets", "pods")
| where (ObjectRefResource == "secrets" and Verb in ("get", "list"))
    or (ObjectRefResource == "pods" and Verb == "create")
| project TimeGenerated, UserUsername, Verb, ObjectRefResource,
          ObjectRefNamespace, ObjectRefName, SourceIPs
| order by TimeGenerated desc
