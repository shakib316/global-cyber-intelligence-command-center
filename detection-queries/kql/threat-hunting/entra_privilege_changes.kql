// ID: GCI-KQL-BEH-ID-001
// Title: Entra privileged role and credential change hunt
// Platform: Microsoft Sentinel
// Type: Behavior-based triage hunt
// Data source: AuditLogs
// Required fields: TimeGenerated, OperationName, Result, InitiatedBy, TargetResources
// Maturity: Draft
// False positives: Approved identity governance, onboarding and privileged access workflows
// Tuning: Validate operation names in tenant; correlate actor, target, ticket and PIM approval
AuditLogs
| where TimeGenerated > ago(24h)
| where OperationName has_any ("Add member to role","Add eligible member to role","Add app role assignment","Add service principal credentials","Update application")
| project TimeGenerated, OperationName, Result, InitiatedBy, TargetResources, CorrelationId
| order by TimeGenerated desc
