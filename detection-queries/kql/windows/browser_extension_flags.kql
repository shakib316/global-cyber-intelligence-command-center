// ID: GCI-KQL-WIN-001
// Title: Browser extension loading and remote-debugging flags
// Platform: Microsoft Defender for Endpoint / Microsoft Sentinel
// Type: Triage hunt (not a definitive malicious-extension signature)
// Data source: DeviceProcessEvents
// Required fields: Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
// Maturity: Draft — needs tenant schema, syntax and false-positive validation
// Source: reports/2026/11/22.md (query consolidated; underlying campaign claims require independent verification)
// ATT&CK: Investigative lead only; do not assign a technique until behaviour is confirmed.
// False positives: Approved browser automation, developer workflows, enterprise extension deployment and browser testing.
// Tuning: Restrict to managed endpoints; baseline approved command-line flags and known automation accounts.

DeviceProcessEvents
| where Timestamp >= ago(7d)
| where FileName in~ ("chrome.exe", "msedge.exe", "brave.exe")
| where ProcessCommandLine has_any (
    "--load-extension",
    "--remote-debugging-port",
    "--remote-debugging-pipe"
)
| project Timestamp, DeviceName, AccountName, FileName,
          ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp desc
