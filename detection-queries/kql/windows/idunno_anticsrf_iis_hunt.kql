// ID: GCI-KQL-WIN-003
// Title: Idunno.AntiCsrf IIS request and known DLL hash hunt
// Platform: Microsoft Sentinel / Microsoft Defender
// Type: Detection hunt / inventory pivot
// Data source: W3CIISLog and DeviceFileEvents
// Required fields: W3CIISLog TimeGenerated, csMethod, csUriStem, scStatus, csBytes, cIP, csUserAgent; DeviceFileEvents TimeGenerated, DeviceName, FolderPath, FileName, SHA256, ActionType
// Prerequisites: IIS logging with cs-bytes and Defender file telemetry.
// Maturity: Draft — request-size threshold is heuristic; confirm IIS fields and application baseline
// Source: Mandiant MNDT-2026-0048, published 2026-11-18; https://github.com/mandiant/Vulnerability-Disclosures/blob/master/2026/MNDT-2026-0048.md
// ATT&CK: T1190 — Exploit Public-Facing Application.
// False positives: Large legitimate WebForms POSTs and normal HTTP 302/500 application behaviour.
// Tuning: Baseline request bytes per application/path; search Web.config and bin directories for module names because rebuilt DLL hashes differ.
// Owner: Security Engineering
// Last reviewed: 2026-11-24
// Review by: 2026-12-01

W3CIISLog
| where TimeGenerated >= ago(14d)
| where csMethod =~ "POST" and csUriStem endswith ".aspx"
| extend Status = toint(scStatus),
         RequestBytes = tolong(csBytes)
| where Status in (302, 500) and RequestBytes > 4096
| project TimeGenerated, Computer, cIP, csUriStem,
          Status, RequestBytes, csUserAgent
| order by TimeGenerated desc

// Known public DLL SHA-256 hunt:
DeviceFileEvents
| where TimeGenerated >= ago(30d)
| where SHA256 in (
    "da1efcfed182597ee946a9ef2895dfdfeab2bdff16855aeef01656d8158ead06",
    "c5c994891783453ae85f3ef8efb48592b7c560aeb56f531ee9ea5736518246eb",
    "aa7bbad4a7ebc38519955ac65517716569508ee4f61fc2f1276086940501e9bf"
)
| project TimeGenerated, DeviceName, FolderPath, FileName,
          SHA256, ActionType, InitiatingProcessAccountName
| order by TimeGenerated desc
