// ID: GCI-YARAL-ID-001
// Title: Repeated failed logins from one principal IP
// Platform: Google SecOps YARA-L 2.0
// Type: Identity threat-hunting rule
// Data source: UDM USER_LOGIN events
// Required fields: metadata.event_type, principal.user.userid, principal.ip, security_result.action
// Maturity: Draft
// Assumptions: Failed authentication is normalized as security_result.action = BLOCK; verify this mapping for each identity source.
// False positives: Shared NAT, password rotation, service-account misconfiguration, stale clients and legitimate user mistakes.
// Tuning: Tune threshold and window by identity provider, user population, source IP reputation and known VPN/NAT egress.
// ATT&CK: T1110 Brute Force; use only when repeated authentication failures are confirmed.
// Validation: Not compiled or run in a Google SecOps tenant; validate event type, action semantics and field population.

// Threshold is a triage starting point, not a universal brute-force threshold.
rule gci_repeated_failed_logins {
  meta:
    author = "Global Cyber Intelligence Command Center"
    description = "Identify repeated blocked login events for one user from one source IP"
    severity = "MEDIUM"
  events:
    $e.metadata.event_type = "USER_LOGIN"
    $e.security_result.action = "BLOCK"
    $user = $e.principal.user.userid
    $ip = $e.principal.ip
  match:
    $user, $ip over 10m
  condition:
    #e >= 10
}
