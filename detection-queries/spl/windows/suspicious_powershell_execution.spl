# ID: GCI-SPL-WIN-001
# Title: Encoded or obfuscated PowerShell process execution
# Platform: Splunk Enterprise / Splunk Enterprise Security
# Type: Endpoint threat-hunting query
# Data source: Sysmon Event ID 1 (Process Create)
# Required fields: index, sourcetype, EventCode, Image, CommandLine, ParentImage, User, Computer
# Maturity: Draft
# Assumptions: Sysmon XML events are indexed with the field names shown; change index/sourcetype to match deployment.
# False positives: Approved administration scripts, software deployment, endpoint management and incident response.
# Tuning: Allowlist signed management scripts and known automation identities; correlate parent process, signer, host and network activity.
# ATT&CK: T1059.001 PowerShell; T1027 only after confirming obfuscation behaviour.
# Validation: Not run against a Splunk instance. This is a hunt, not a production alert.

index=windows sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
(Image="*\\powershell.exe" OR OriginalFileName="PowerShell.EXE")
| eval command_lower=lower(CommandLine)
| where match(command_lower, "(-enc(odedcommand)?\\s+[a-z0-9+/=]{20,}|frombase64string|downloadstring|invoke-expression|\\biex\\s*\\()")
| table _time Computer User ParentImage Image CommandLine ProcessId ParentProcessId
| sort - _time
